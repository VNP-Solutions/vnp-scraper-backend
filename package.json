  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "decrypt-password": "ts-node scripts/decrypt-password.ts",
    "migrate:add-is-archived": "ts-node migrations/add-is-archived-field.ts",
    "backup:full": "ts-node scripts/backup-full-ejson.ts",
    "backup:restore": "ts-node scripts/dump-and-restore-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1043.0",
    "@aws-sdk/client-s3": "^3.812.0",
    "@aws-sdk/client-sqs": "^3.1043.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.7.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "axios": "1.10.0",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "googleapis": "^149.0.0",
    "mongodb": "^7.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
