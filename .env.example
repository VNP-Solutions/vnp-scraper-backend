DATABASE_URL=
NODE_ENV=
PORT=
SECRET_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
JWT_EXPIRES_IN=
INVITATION_REDIRECT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_URL=
SHEET_SCRIPT_URL=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_S3_KEY=google-oauth/token.json
# Optional. Path on Booking scraper for batch-property-run-job-by-booking-credentials only (default /api/booking/bulk-property-run-job)
# BOOKING_GROUPED_BULK_API_PATH=
# true = also log Booking bulk HTTP response + error response body; enables POST body log when NODE_ENV=production
# BOOKING_BULK_DEBUG_LOG=

# Ejoin hardware SMS gateway (LAN IP or ngrok URL — NOT your website)
EJOIN_SMS_GATEWAY_URL=http://192.168.1.100
EJOIN_SMS_USERNAME=admin
EJOIN_SMS_PASSWORD=your_device_password
# Optional modem port 1–64
# EJOIN_SMS_FROM_PORT=1

# Link shown inside audit SMS bodies (/progress/{jobId}, /audits/{jobId})
DEMO_WEBSITE_URL=https://your-audit-site.com

# Optional: ejoin | twilio | auto (default: Ejoin if configured, else Twilio)
# AUDIT_SMS_PROVIDER=auto

# Twilio fallback (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional overrides for OTP reminder SMS body
# OTP_SUPPORT_PHONE=(571) 238-0638
# OTP_SUPPORT_EMAIL=ITSUPPORT@vnpsolutions.com
