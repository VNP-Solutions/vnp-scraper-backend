# =============================================================================
# VNP Scraper Backend — local development (no Docker)
# =============================================================================
# Swagger: http://localhost:8081/api
# API base: http://localhost:8081  (no /api global prefix on routes)
# Portfolio sync-create (from DBMS): POST /portfolios/sync-create
# =============================================================================

NODE_ENV=development
PORT=8081

# Database (Atlas or local MongoDB — separate DB from DBMS/Dashboard recommended)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority&appName=VnpParser&tlsAllowInvalidCertificates=true

# App JWT (Scraper user auth)
SECRET_KEY=<secret-key>
JWT_EXPIRES_IN=3650d

# Cross-backend sync auth (Scraper ↔ Dashboard; DBMS → Scraper portfolio sync)
# MUST be identical on DBMS, Dashboard, and Scraper.
JWT_COMMUNICATION_SECRET=local-dev-communication-secret-change-me
JWT_COMMUNICATION_TOKEN_EXPIRES_IN=1d

# Fallback alias for communication secret (optional; JWT_COMMUNICATION_SECRET takes precedence)
DASHBOARD_PROXY_SECRET=

# Scraper → Dashboard outbound calls (QA panel / audit proxy)
DASHBOARD_PROXY_URL=http://localhost:5001

# Inbound service-token auth (property sync endpoints still using X-Service-Token)
SERVICE_TOKEN=local-dev-service-token-change-me
DBMS_SERVICE_TOKEN=local-dev-service-token-change-me

# Public URL of this Scraper API
SCRAPER_BASE_URL=http://localhost:8081

# SMTP
SMTP_EMAIL=<smtp-email>
SMTP_PASSWORD=<smtp-password>
INVITATION_REDIRECT_URL=http://localhost:5000

# AWS S3
S3_BUCKET_NAME=<s3-bucket-name>
S3_REGION=us-east-1
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>
S3_BUCKET_URL=<s3-bucket-url>

ENCRYPTION_KEY=<encryption-key>
EXPEDIA_MODE=graphql

# Optional remote workers (leave empty if unused locally)
EXPEDIA_RETRIVAL_SERVER_URL=
EXPEDIA_DB_SERVER_URL=
AGODA_RETRIVAL_SERVER_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_S3_KEY=
QUEUE_URL=
PRIORITY_QUEUE_URL=
LAMBDA_FUNCTION_NAME=
