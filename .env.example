DATABASE_URL=
NODE_ENV=
PORT=
SECRET_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
JWT_EXPIRES_IN=
INVITATION_REDIRECT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_URL=
SHEET_SCRIPT_URL=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_S3_KEY=google-oauth/token.json
# Optional. Path on Booking scraper for batch-property-run-job-by-booking-credentials only (default /api/booking/bulk-property-run-job)
# BOOKING_GROUPED_BULK_API_PATH=
# true = also log Booking bulk HTTP response + error response body; enables POST body log when NODE_ENV=production
# BOOKING_BULK_DEBUG_LOG=

# Cron expression for scheduled jobs (in cron format: second minute hour day month day-of-week)
# Default: '0 0 0 * * *' (every day at midnight)
SCHEDULED_JOB_CRON_TIME=0 0 0 * * *

# Comma-separated list of email addresses to receive the daily job statistics report.
# Leave empty to disable the daily statistics email.
# Example: REPORT_STATISTICS_EMAIL_RECIPIENTS=admin@example.com,manager@example.com
REPORT_STATISTICS_EMAIL_RECIPIENTS=

# Cron expression for the daily job statistics email (second minute hour day month day-of-week).
# Default: '0 0 12 * * *' (every day at 12:00 noon)
REPORT_STATISTICS_CRON_TIME=0 0 12 * * *

# AWS SQS and Lambda Configuration (uses S3 credentials above)
QUEUE_URL=
LAMBDA_FUNCTION_NAME=
# AWS SQS queue for background bulk job-items imports (multi-job file uploads)
BULK_JOB_ITEMS_IMPORT_QUEUE_URL=
# Dashboard proxy base URL used by QA panel uploads:
#   POST /qa-panel/upload           → {DASHBOARD_PROXY_URL}/api/external/bulk-audit-import/ota
#   POST /qa-panel/ota-post/upload  → {DASHBOARD_PROXY_URL}/api/external/bulk-audit-import/ota-post
# On completion the proxy callbacks:
#   ota      → POST {EXTERNAL_BASE_URL}/qa-panel/import-callback
#   ota-post → POST {EXTERNAL_BASE_URL}/qa-panel/ota-post/import-callback
DASHBOARD_PROXY_URL=https://dashboard-backend.vnpmanage.online
# Secret used to sign the Bearer token sent to the dashboard proxy API
JWT_COMMUNICATION_SECRET=
# Optional token expiry for dashboard proxy auth (default: 1d)
JWT_COMMUNICATION_TOKEN_EXPIRES_IN=1d
# AWS SQS queue for background OTA post pre-charging conversions (>= 1000 rows)

# Optional. Gmail label holding the Agoda Partner Support correspondence
# (both directions), searched by POST /api/agoda/retrive-case-email.
# Default: agoda-responses
# AGODA_SUPPORT_EMAIL_LABEL=agoda-responses
