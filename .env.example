DATABASE_URL=mongodb://localhost:27017/vnp-scraper
NODE_ENV=development
PORT=5000
SECRET_KEY=your-jwt-secret-key
SMTP_EMAIL=noreply@vnpsolutions.com
SMTP_PASSWORD=
JWT_EXPIRES_IN=30d
INVITATION_REDIRECT_URL=http://localhost:5173/invitation
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
S3_BUCKET_URL=https://your-bucket.s3.amazonaws.com
SHEET_SCRIPT_URL=
ENCRYPTION_KEY=your-32-character-encryption-key

# Prisma Migration Settings
# AUTO_MIGRATE: Enable automatic database migrations on startup (true/false)
# Default: true in Docker, can be disabled by setting to false
AUTO_MIGRATE=true

# STRICT_MIGRATION: Exit application if migrations fail (true/false)
# Default: false - application continues even if migrations fail
# Set to true for production environments where schema must be correct
STRICT_MIGRATION=false

# Modular Scraper URL (for trust verification and job routing)
MODULAR_SCRAPER_URL=http://localhost:3000